{
    "name": "joshmckibbin/post-to-pdf-for-convertapi",
    "description": "A WordPress plugin that automatically converts posts to PDFs using ConvertAPI",
    "type": "project",
    "authors": [
        {
            "name": "Josh Mckibbin",
            "email": "joshmckibbin@gmail.com"
        }
    ],
    "require": {
        "yahnis-elsts/plugin-update-checker": "^5.7"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.4"
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf"
    }
}
